rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin collection - only admins can read (to check their own status)
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false; // Manually managed in Firebase Console
    }

    // Tournament lock: brackets cannot be written after Nov 3, 2026 00:00 UTC (9:00 AM JST)
    match /brackets-men/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.time < timestamp.date(2026, 11, 3);
    }

    match /brackets-women/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.time < timestamp.date(2026, 11, 3);
    }

    // Actual results - anyone can read, only admins can write
    match /actualResults-men/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /actualResults-women/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Settings - anyone can read, only admins can write
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Leagues - any authenticated user can read; non-anonymous can create; admins can delete
    match /groups/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
      allow update: if false;
    }
  }
}
